{
  "kind": "artisan-document",
  "version": 1,
  "id": "promo-banner",
  "name": "Promo Banner",
  "props": { "schema": { "type": "object", "properties": { "headline": { "type": "string" } } }, "defaults": { "headline": "SUMMER SALE" } },
  "artboards": [
    {
      "id": "banner",
      "width": 300,
      "height": 100,
      "background": { "type": "solid", "color": "#ff004d" },
      "children": [
        { "id": "headline", "type": "text", "content": { "$prop": "headline" }, "style": { "fontSize": 28, "fontWeight": 900, "textAlign": "center", "verticalAlign": "middle" }, "transform": { "x": 0, "y": 0, "width": 300, "height": 100 } }
      ]
    }
  ]
}
