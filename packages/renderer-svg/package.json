{
  "name": "@game-artisan/renderer-svg",
  "version": "1.0.0",
  "description": "Fast headless vector renderer: UDM -> SVG (isomorphic) -> resvg PNG -> sharp WebP/JPEG, plus vector PDF export.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./node": { "types": "./dist/node.d.ts", "import": "./dist/node.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts src/node.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit -p .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@game-artisan/core": "workspace:*",
    "@game-artisan/fonts": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "pdfkit": "^0.17.2",
    "sharp": "^0.34.5",
    "svg-to-pdfkit": "^0.1.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.13.9",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT"
}
