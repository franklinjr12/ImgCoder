{
  "name": "@game-artisan/cli",
  "version": "1.0.0",
  "description": "The `artisan` command line: list, inspect, render, batch, studio, serve, mcp, agent:matrix, init.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": { "artisan": "./dist/bin.js" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit -p .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@game-artisan/agent-sdk": "workspace:*",
    "@game-artisan/core": "workspace:*",
    "@game-artisan/runtime": "workspace:*",
    "@game-artisan/templates-game": "workspace:*",
    "commander": "^13.1.0"
  },
  "optionalDependencies": {
    "@game-artisan/studio": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT"
}
